# 环境变量样例：复制为 .env 或由部署平台注入。secret 不写入 YAML/仓库。
# ---- LLM 接入 ----
# 推荐方式：直接打开 /admin/llm 设置页填写 API Key（写入 data/llm.json，无需环境变量）；
# 其他工具可通过 /api/llm/chat 复用同一份配置（本机直连免令牌）。
# VIBERADAR_LLM_PROVIDER：auto=有档案用档案、否则 mock；也可显式 mock|none|deepseek|config|<档案名>
VIBERADAR_LLM_PROVIDER=auto
# 仅远程调用 /api/llm/* 时需要令牌（本机直连免）
VIBERADAR_LLM_API_TOKEN=
# 旧式环境变量直连 DeepSeek（VIBERADAR_LLM_PROVIDER=deepseek 时生效）
DEEPSEEK_API_KEY=
# VIBERADAR_STRICT_LLM=1 时，无模型维度不得自动刊登（生产建议开启）
VIBERADAR_STRICT_LLM=0

# ---- 采集凭据 ----
GITHUB_TOKEN=
# PRODUCTHUNT_TOKEN=（凭据与条款核查通过后才启用 producthunt 源）

# ---- 分发 ----
VIBERADAR_FEISHU_WEBHOOK_URL=

# ---- 站点 ----
VIBERADAR_SITE_URL=http://127.0.0.1:8000
VIBERADAR_ADMIN_TOKEN=
# 用于派生匿名 actor 的服务端密钥；生产必须替换为随机值
VIBERADAR_SECRET_KEY=change-me-to-a-random-secret

# ---- 运行目录（默认使用项目内 data/） ----
# VIBERADAR_DATA_DIR=/var/lib/viberadar
# VIBERADAR_DB_PATH=/var/lib/viberadar/viberadar.sqlite3
# VIBERADAR_CONFIG_DIR=/app/config
